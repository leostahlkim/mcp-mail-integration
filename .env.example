# Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional: Redirect URI is auto-detected from ngrok if running, otherwise uses localhost
# GMAIL_REDIRECT_URI=http://localhost:3000/auth/callback?provider=gmail

# Yahoo OAuth (requires HTTPS - use ngrok for local development)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Optional: Redirect URI is auto-detected from ngrok if running, otherwise uses localhost
# YAHOO_REDIRECT_URI=http://localhost:3000/auth/callback?provider=yahoo

# Claude API
ANTHROPIC_API_KEY=

# MCP Server
MCP_SERVER_PORT=3001

# Security
TOKEN_ENCRYPTION_KEY=

# ============================================
# ngrok Integration (for local HTTPS support)
# ============================================
# OAuth redirect URIs are automatically detected:
# - If ngrok is running on port 3000, uses the HTTPS tunnel URL
# - Otherwise, falls back to http://localhost:3000
#
# To use ngrok for Yahoo OAuth (which requires HTTPS):
#   Option 1: pnpm dev:tunnel   (auto-starts ngrok + dev server)
#   Option 2: pnpm tunnel:start (terminal 1) + pnpm dev (terminal 2)
